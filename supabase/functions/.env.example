# SERVER-ONLY secrets for the stripe-webhook Edge Function.
# Never put these in the root .env or anywhere the frontend build can read them.
# Set them with:  supabase secrets set --env-file supabase/functions/.env
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Payment Link IDs (start with plink_), from the Stripe dashboard URL of each link
STRIPE_PRO_LINK_ID=plink_xxx
STRIPE_MAX_LINK_ID=plink_xxx
