# StudyBloom frontend config. Copy to .env and fill in. No quotes around values.
# These are PUBLIC values: they end up in dist/config.js in the browser.
# NEVER put the Supabase service_role key or the Stripe secret key here.
# (Leave the Supabase lines empty to run in "local demo mode" with no backend.)

# Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Stripe (test mode) > Payment Links > copy each link's URL
STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/test_xxx
STRIPE_PAYMENT_LINK_MAX=https://buy.stripe.com/test_yyy
